{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "chafa",
        "source": "/home/kimo/Pictures/catc.c.jpg",
        "width": 38,
        "height": 22,
        "position": "left",
        "padding": {
            "right": 5
        }
    },
    "display": {
        "separator": "",
        "color": {
            // k4-palette remaps the terminal ANSI slots used by these names.
            "keys": "green",
            // Use the terminal's foreground so this remains readable in both
            // light and dark modes; k4-palette supplies the accent for keys.
            "output": "default"
        },
        "key": {
            "width": 0
        },
        "brightColor": true
    },
    "modules": [
        // One-line spacers preserve the image rows while centering PC STATUS.
        {
            "type": "custom",
            "format": " "
        },
        {
            "type": "custom",
            "format": " "
        },
        {
            "type": "custom",
            "format": " "
        },
        {
            "type": "custom",
            "format": "{#green}╭─ {#bright_green}PC STATUS{#green} ───────────────────────────────────────────────────────╮"
        },
        {
            "type": "title",
            "key": "{#green}│  USER       ",
            "format": "{user-name} {#green}│"
        },
        {
            "type": "title",
            "key": "{#green}│  HOST       ",
            "format": "{host-name} {#green}│"
        },
        {
            "type": "custom",
            "format": "{#green}├──────────────────────────────────────────────────────────────────┤"
        },
        {
            "type": "os",
            "key": "{#green}│  OS         ",
            "format": "{name} {#green}│"
        },
        {
            "type": "kernel",
            "key": "{#green}│  KERNEL     ",
            "format": "{release} {#green}│"
        },
        {
            "type": "cpu",
            "key": "{#green}│  CPU        ",
            "format": "{name} {#green}│",
            "showPeCoreCount": true
        },
        {
            "type": "gpu",
            "key": "{#green}│  GPU        ",
            "format": "{name} {#green}│"
        },
        {
            "type": "memory",
            "key": "{#green}│  MEMORY     ",
            "format": "{used} / {total} {#green}│"
        },
        {
            "type": "disk",
            "key": "{#green}│  DISK       ",
            "folders": "/",
            "format": "{size-used} / {size-total} {#green}│"
        },
        {
            "type": "de",
            "key": "{#green}│  DESKTOP    ",
            "format": "{pretty-name} {#green}│"
        },
        {
            "type": "shell",
            "key": "{#green}│  SHELL      ",
            "format": "{pretty-name} {#green}│"
        },
        {
            "type": "uptime",
            "key": "{#green}│  UPTIME     ",
            "format": "{days}d {hours}h {minutes}m {#green}│"
        },
        {
            "type": "custom",
            "format": "{#green}╰──────────────────────────────────────────────────────────────────╯"
        }
    ]
}
