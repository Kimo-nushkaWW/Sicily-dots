{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "chafa",
        "source": "/home/kimo/Pictures/cat-c.c.jpg",
        "width": 42,
        "height": 24,
        "position": "left",
        "padding": {
            "right": 5
        }
    },
    "display": {
        "separator": "",
        "color": {
            "keys": "green",
            "output": "white"
        },
        "key": {
            "width": 0
        },
        "brightColor": true
    },
    "modules": [
        {
            "type": "custom",
            "format": "{#green}╭─ {#bright_green}PC STATUS{#green} ───────────────────────────────────────────────────────╮"
        },
        {
            "type": "title",
            "key": "{#green}│  USER       ",
            "format": "{user-name} {#green}│"
        },
        {
            "type": "title",
            "key": "{#green}│  HOST       ",
            "format": "{host-name} {#green}│"
        },
        {
            "type": "custom",
            "format": "{#green}├──────────────────────────────────────────────────────────────────┤"
        },
        {
            "type": "os",
            "key": "{#green}│  OS         ",
            "format": "{name} {#green}│"
        },
        {
            "type": "kernel",
            "key": "{#green}│  KERNEL     ",
            "format": "{release} {#green}│"
        },
        {
            "type": "cpu",
            "key": "{#green}│  CPU        ",
            "format": "{name} {#green}│",
            "showPeCoreCount": true
        },
        {
            "type": "gpu",
            "key": "{#green}│  GPU        ",
            "format": "{name} {#green}│"
        },
        {
            "type": "memory",
            "key": "{#green}│  MEMORY     ",
            "format": "{used} / {total} {#green}│"
        },
        {
            "type": "disk",
            "key": "{#green}│  DISK       ",
            "folders": "/",
            "format": "{size-used} / {size-total} {#green}│"
        },
        {
            "type": "de",
            "key": "{#green}│  DESKTOP    ",
            "format": "{pretty-name} {#green}│"
        },
        {
            "type": "shell",
            "key": "{#green}│  SHELL      ",
            "format": "{pretty-name} {#green}│"
        },
        {
            "type": "uptime",
            "key": "{#green}│  UPTIME     ",
            "format": "{days}d {hours}h {minutes}m {#green}│"
        },
        {
            "type": "custom",
            "format": "{#green}╰──────────────────────────────────────────────────────────────────╯"
        }
    ]
}
